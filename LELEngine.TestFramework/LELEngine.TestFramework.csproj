<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game's unit tests: NUnit-style attributes and asserts for scripts in Tests folders (Game.Tests.dll), and the
       runner the editor's Test Runner window and batch mode (-runTests) drive. Ships with the editor only: the player
       never references it, and test scripts never reach a game build. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LELEngine.Testing</RootNamespace>
    <AssemblyName>LELEngine.TestFramework</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LELEngine\LELEngine.csproj" />
  </ItemGroup>

</Project>
