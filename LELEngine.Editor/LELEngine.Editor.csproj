<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A window application: the editor opens no console window. Batch mode attaches to the calling terminal;
         LELEngine.Editor.Console.exe (written next to it) is the console twin for terminals and CI: the shell
         waits for it and gets its exit code. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>LELEngine.Editor</RootNamespace>
    <AssemblyName>LELEngine.Editor</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.9" />
    <!-- Model import (FBX, glTF, Collada, ...): the editor only; builds ship the imported data. -->
    <PackageReference Include="Silk.NET.Assimp" Version="2.22.0" />
    <!-- BC7 texture compression for builds (KTX files the player uploads as they are): the editor only. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LELEngine\LELEngine.csproj" />
    <!-- Built first; its output is copied to Player/ next to the editor (game builds start from it). -->
    <ProjectReference Include="..\LELEngine.Player\LELEngine.Player.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPlayer" AfterTargets="Build">
    <ItemGroup>
      <PlayerFiles Include="..\LELEngine.Player\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerFiles)" DestinationFiles="@(PlayerFiles->'$(OutDir)Player\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish: the player is published into Player/ of the editor's publish folder, so one `dotnet publish` gives an
       editor ready to build games. PlayerRuntimeIdentifier is the platform of the games (default: the editor's
       runtime identifier; none: framework-dependent, every OS with .NET). With one the player is self-contained
       (games run without .NET installed; PlayerSelfContained=false turns that off).
         dotnet publish LELEngine.Editor -c Release -r win-x64
         dotnet publish LELEngine.Editor -c Release -r win-x64 -p:PlayerRuntimeIdentifier=linux-x64 -->
  <PropertyGroup>
    <PlayerRuntimeIdentifier Condition="'$(PlayerRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</PlayerRuntimeIdentifier>
    <PlayerSelfContained Condition="'$(PlayerSelfContained)' == '' And '$(PlayerRuntimeIdentifier)' != ''">true</PlayerSelfContained>
    <PlayerSelfContained Condition="'$(PlayerSelfContained)' == ''">false</PlayerSelfContained>
  </PropertyGroup>

  <Target Name="PublishPlayer" AfterTargets="Publish">
    <PropertyGroup>
      <!-- Absolute, without the trailing separator (a quoted path ending in \ would escape the quote). -->
      <PlayerPublishDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)', 'Player'))).TrimEnd('\').TrimEnd('/'))</PlayerPublishDir>
      <PlayerProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\LELEngine.Player\LELEngine.Player.csproj'))</PlayerProject>
      <!-- The dotnet running this build. -->
      <PlayerDotnet>$(DOTNET_HOST_PATH)</PlayerDotnet>
      <PlayerDotnet Condition="'$(PlayerDotnet)' == ''">dotnet</PlayerDotnet>
      <PlayerArguments>publish "$(PlayerProject)" -c $(Configuration) -o "$(PlayerPublishDir)" --nologo</PlayerArguments>
      <PlayerArguments Condition="'$(PlayerRuntimeIdentifier)' != ''">$(PlayerArguments) -r $(PlayerRuntimeIdentifier) --self-contained $(PlayerSelfContained)</PlayerArguments>
      <PlayerDescription>$(PlayerRuntimeIdentifier), self-contained $(PlayerSelfContained)</PlayerDescription>
      <PlayerDescription Condition="'$(PlayerRuntimeIdentifier)' == ''">framework-dependent, any OS</PlayerDescription>
    </PropertyGroup>
    <!-- A process of its own: its restore is for the player's runtime identifier (the editor's restore was for the
         editor's), and none of the editor's publish options (single file, trimming) reach the player. -->
    <Exec Command="&quot;$(PlayerDotnet)&quot; $(PlayerArguments)" />
    <Message Importance="high" Text="Player ($(PlayerDescription)) -> $(PlayerPublishDir)" />
  </Target>

  <!-- Console twin of the launcher: the same app host (it starts LELEngine.Editor.dll) with the PE subsystem set to
       console. -->
  <UsingTask TaskName="WriteConsoleAppHost" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        byte[] image = System.IO.File.ReadAllBytes(Source);
        int header = System.BitConverter.ToInt32(image, 0x3C);
        if (header <= 0 || header + 24 + 70 > image.Length || image[header] != (byte)'P' || image[header + 1] != (byte)'E')
        {
          Log.LogError("Not a PE image: " + Source);
          return false;
        }

        // Optional header (after the 4-byte signature and the 20-byte file header): Subsystem at offset 68.
        int subsystem = header + 24 + 68;
        image[subsystem] = 3; // IMAGE_SUBSYSTEM_WINDOWS_CUI
        image[subsystem + 1] = 0;
        System.IO.File.WriteAllBytes(Destination, image);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ConsoleAppHost" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And Exists('$(OutDir)$(AssemblyName).exe')" Inputs="$(OutDir)$(AssemblyName).exe" Outputs="$(OutDir)$(AssemblyName).Console.exe">
    <WriteConsoleAppHost Source="$(OutDir)$(AssemblyName).exe" Destination="$(OutDir)$(AssemblyName).Console.exe" />
  </Target>

  <!-- The console twin in the publish folder too (build machines run batch mode through it). -->
  <Target Name="PublishConsoleAppHost" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' And Exists('$(PublishDir)$(AssemblyName).exe')">
    <WriteConsoleAppHost Source="$(PublishDir)$(AssemblyName).exe" Destination="$(PublishDir)$(AssemblyName).Console.exe" />
  </Target>

  <!-- Starter assets copied into every new project (Templates/NewProject/Assets in the editor output). -->
  <ItemGroup>
    <Content Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestGame\Assets\Meshes\cube.obj" Link="Templates\NewProject\Assets\Meshes\Cube.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestGame\Assets\Meshes\sphere.obj" Link="Templates\NewProject\Assets\Meshes\Sphere.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestGame\Assets\Meshes\quad.obj" Link="Templates\NewProject\Assets\Meshes\Quad.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The lit shaders are engine shaders (ShaderLibrary/Engine): the GI depends on them, so projects do not get copies. -->
  </ItemGroup>

</Project>
