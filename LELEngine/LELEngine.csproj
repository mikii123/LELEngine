<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LELEngine</RootNamespace>
    <AssemblyName>LELEngine</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- OpenTK's GLFW functions take and return Window* (GraphicsThread, Window). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- 2D physics: Box2D v3 ported to pure C# (ikpil's Box2D.NET; LELEngine.Physics2D wraps it with a Unity-style API). -->
    <PackageReference Include="Box2D.NET" Version="3.1.654" />
    <!-- Audio decoders, pure managed (LELEngine.Audio): Ogg Vorbis and MP3; WAV is read by the engine itself. -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>

  <!-- Engine GLSL library (includes and engine-owned passes). Published to Shaders/Engine/ in the game output. -->
  <ItemGroup>
    <Content Include="ShaderLibrary\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Shaders\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Built-in assets (primitive meshes, the default material): read-only engine resources ("Engine/Meshes/Cube.obj"),
       next to the binaries in BuiltinAssets/ like the shader library, never copied into projects. -->
  <ItemGroup>
    <Content Include="BuiltinAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>BuiltinAssets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
