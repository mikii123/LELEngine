<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LELEngine</RootNamespace>
    <AssemblyName>LELEngine</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- 2D physics: a C# port of Box2D 2.4.1 (LELEngine.Physics2D wraps it with a Unity-style API). -->
    <PackageReference Include="Box2DSharp" Version="0.6.0" />
  </ItemGroup>

  <!-- Engine GLSL library (includes and engine-owned passes). Published to Shaders/Engine/ in the game output. -->
  <ItemGroup>
    <Content Include="ShaderLibrary\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Shaders\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
