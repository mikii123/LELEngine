<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A window application: no console window; the log goes to Player.log (and to stdout when redirected). -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>LELEngine.Player</RootNamespace>
    <AssemblyName>LELEngine.Player</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Game builds load the game's scripts assembly next to the player. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- A player published for a platform (the self-contained player; the framework-dependent one of an editor published
       with a runtime identifier) carries its code compiled ahead of time (ReadyToRun): the engine's and the libraries'
       methods no longer compile the first time each runs, which in a game is the frame something first happens in (a
       scene's first frame, a first shot). Publishing needs the SDK's crossgen package for it (restored from NuGet once).
       The player `dotnet build` copies next to a development editor is not published: its code compiles as it runs. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LELEngine\LELEngine.csproj" />
  </ItemGroup>

</Project>
